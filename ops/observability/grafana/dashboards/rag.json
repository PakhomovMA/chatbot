{
  "uid": "chatbot-rag",
  "title": "Chatbot / Rag",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "chatbot",
    "O04"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Multi-pass workflow p95",
      "type": "timeseries",
      "description": "Expansion/decomposition wall time including preparation and merge. Single-pass search has its own timer.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,strategy) (rate(chatbot_retrieval_workflow_seconds_bucket{job=\"chatbot\"}[5m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Pass p95",
      "type": "timeseries",
      "description": "One deterministic retrieval pass.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,mode) (rate(chatbot_retrieval_search_seconds_bucket{job=\"chatbot\"}[5m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Pass work / s",
      "type": "timeseries",
      "description": "Accumulated work across passes; not request latency.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(chatbot_retrieval_search_seconds_sum{job=\"chatbot\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Facet p95",
      "type": "timeseries",
      "description": "Vector includes query embedding; do not add it again.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,stage,mode) (rate(chatbot_retrieval_stage_seconds_bucket{job=\"chatbot\"}[5m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Mean hits / pass",
      "type": "timeseries",
      "description": "Zero hits is a valid search result.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(chatbot_retrieval_hits_sum{job=\"chatbot\"}[5m])) / clamp_min(sum (rate(chatbot_retrieval_hits_count{job=\"chatbot\"}[5m])), 0.000001)",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Grounding outcomes / s",
      "type": "timeseries",
      "description": "Insufficient evidence is a successful application outcome.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grounding) (rate(chatbot_chat_request_seconds_count{job=\"chatbot\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Expansion and decomposition / s",
      "type": "timeseries",
      "description": "Closed business outcomes; no extra request count.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(chatbot_retrieval_expansion_total{job=\"chatbot\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(chatbot_chat_decomposition_total{job=\"chatbot\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Embedding wait and batch p95",
      "type": "timeseries",
      "description": "Slot wait and accepted batch processing are separate intervals.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,mode) (rate(chatbot_embedding_wait_seconds_bucket{job=\"chatbot\"}[5m])))",
          "legendFormat": "__auto",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,mode) (rate(chatbot_embedding_seconds_bucket{job=\"chatbot\"}[5m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Search budget decisions / s",
      "type": "timeseries",
      "description": "Tool budget decisions, including exhaustion.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(chatbot_chat_agentic_search_total{job=\"chatbot\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Agentic searches / s",
      "type": "timeseries",
      "description": "Published only when the agentic tool loop runs.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chatbot-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chatbot_chat_agentic_search_total{job=\"chatbot\",outcome=\"ran\"}[5m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
