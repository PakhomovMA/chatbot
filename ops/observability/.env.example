# Copy to .env and replace every placeholder before starting the stack. .env is ignored by Git.
#
#   cp -n ops/observability/.env.example ops/observability/.env
#
# Nothing here is read by the application: the collector holds the Langfuse credentials, and the
# chatbot only knows the local OTLP address (docs/observability-plan.md §7.1).

# ---- profile `metrics` -------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password

# ---- profile `llm` -----------------------------------------------------------------------------
# Langfuse creates the organisation, the project and the API keys below on its first start, so the
# collector authenticates with keys that already exist here instead of ones copied out of the UI.
# The keys are arbitrary strings; keep Langfuse's own pk-lf-/sk-lf- shape so they are recognisable.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-a-local-key
LANGFUSE_SECRET_KEY=sk-lf-replace-with-a-local-key
# base64 of "<public key>:<secret key>", which is what the collector sends as Basic auth:
#   printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64
LANGFUSE_AUTH=replace-with-the-base64-of-publickey-colon-secretkey

# The first Langfuse user; the UI sign-in on http://127.0.0.1:3000.
LANGFUSE_INIT_USER_EMAIL=local@example.invalid
LANGFUSE_INIT_USER_NAME=Local
LANGFUSE_INIT_USER_PASSWORD=replace-with-a-local-password

# Secrets of the Langfuse deployment itself. Generate them, do not reuse the examples:
#   openssl rand -hex 32   (ENCRYPTION_KEY must be exactly 64 hex characters)
#   openssl rand -base64 32
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=replace-with-a-random-secret
LANGFUSE_SALT=replace-with-a-random-salt

# Stores. They are not published on the host; these are still real credentials.
LANGFUSE_POSTGRES_PASSWORD=replace-with-a-local-password
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-a-local-password
LANGFUSE_REDIS_PASSWORD=replace-with-a-local-password
LANGFUSE_MINIO_PASSWORD=replace-with-a-local-password

# Which deployment the traces belong to, when a span does not say so itself. Lowercase letters,
# digits, hyphen and underscore only.
LANGFUSE_ENVIRONMENT=local
# The collector's destination. Langfuse's OTLP base endpoint, WITHOUT /v1/traces: the exporter
# appends the signal path itself (docs/observability.md).
LANGFUSE_OTEL_ENDPOINT=http://langfuse-web:3000/api/public/otel

# The application reads these separately, not from Compose .env:
# CHATBOT_MANAGEMENT_PORT=8081
# CHATBOT_MANAGEMENT_ADDRESS=127.0.0.1
# If the port changes, also change prometheus/prometheus.yml targets.
# CHATBOT_OTLP_ENDPOINT=http://localhost:4318/v1/traces   (the full signal URL, with /v1/traces)
# CHATBOT_TRACE_SAMPLING=1.0
# CHATBOT_ENVIRONMENT=local
# CHATBOT_RELEASE=dev
